  <img id="lb-img" class="max-h-[70vh] max-w-full rounded-xl hidden" alt="">
  <div id="lb-video-container" class="w-full aspect-video rounded-xl overflow-hidden hidden bg-zinc-900 border border-zinc-800 flex flex-col items-center justify-center p-6 text-center space-y-4">
   <i class="fab fa-facebook text-6xl text-brand-500"></i>
   <h4 class="text-xl font-bold">Featured Facebook Video Memory</h4>
   <p class="text-xs text-zinc-400 max-w-md">Click below to watch the official batch video directly on Facebook.</p>
   <a id="fb-video-link" href="https://www.facebook.com/share/v/1EQKpXcSqm/" target="_blank" class="px-6 py-3 rounded-xl bg-brand-600 text-white font-bold text-xs uppercase tracking-wider inline-flex items-center gap-2"><i class="fab fa-facebook-f"></i> Open Facebook Video <i class="fas fa-external-link-alt text-xs"></i></a>
  </div>
  <p id="lb-cap" class="mt-4 text-sm text-zinc-300 text-center max-w-lg"></p>
 </div>
</div>

<!-- ADMIN MODAL -->
<div id="admin-modal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm overflow-y-auto">
 <div class="min-h-full flex items-start sm:items-center justify-center p-3 sm:p-6">
  <div class="w-full max-w-3xl bg-zinc-950 border border-zinc-800 rounded-2xl shadow-2xl">
   <div class="flex items-center justify-between px-5 py-4 border-b border-zinc-800">
    <h3 class="font-black flex items-center gap-2"><i class="fas fa-user-shield text-brand-500"></i> Admin Panel</h3>
    <button id="admin-close" class="text-zinc-400 hover:text-white text-xl" aria-label="Close"><i class="fas fa-times"></i></button>
   </div>

   <!-- login -->
   <div id="admin-login" class="p-6 space-y-3">
    <p class="text-sm text-zinc-400">Enter the admin password to edit photos and manage batchmates (Default: <code class="text-brand-400 font-mono">orthohin27</code>).</p>
    <input id="admin-pass" type="password" class="inp" placeholder="Password" autocomplete="current-password">
    <p id="login-err" class="text-xs text-brand-400 hidden">Wrong password. Try again.</p>
    <button id="login-btn" class="ab red w-full justify-center py-2.5">Unlock</button>
   </div>

   <!-- panel -->
   <div id="admin-panel" class="hidden">
    <div class="flex gap-2 px-5 pt-4 text-xs font-bold overflow-x-auto">
     <button class="tab ab red" data-tab="t-gallery">Gallery photos</button>
     <button class="tab ab" data-tab="t-batchmates">Batchmates list</button>
     <button class="tab ab" data-tab="t-profile">Profile photo</button>
     <button class="tab ab" data-tab="t-data">Backup & security</button>
    </div>

    <div id="t-gallery" class="tabp p-5 space-y-4">
     <div class="flex flex-wrap gap-2 items-center justify-between">
      <p class="text-xs text-zinc-400"><span id="count">0</span> photos · changes save automatically</p>
      <button id="add-btn" class="ab red"><i class="fas fa-plus"></i> Add photos</button>
     </div>
     <div id="admin-list" class="space-y-3 max-h-[50vh] overflow-y-auto pr-2"></div>
    </div>

    <div id="t-batchmates" class="tabp hidden p-5 space-y-4">
     <div class="flex justify-between items-center">
      <p class="text-xs text-zinc-400">Manage registered batchmates</p>
      <button onclick="showSection('register'); $('#admin-modal').classList.add('hidden');" class="ab red"><i class="fas fa-plus"></i> Add new</button>
     </div>
     <div id="admin-batchmates-list" class="space-y-3 max-h-[50vh] overflow-y-auto pr-2"></div>
    </div>

    <div id="t-profile" class="tabp hidden p-5 space-y-3">
     <img id="prof-prev" class="w-28 h-28 rounded-full object-cover object-top border border-zinc-800" alt="">
     <input id="prof-url" class="inp" placeholder="Image URL or file name">
     <div class="flex flex-wrap gap-2">
      <button id="prof-upload" class="ab red"><i class="fas fa-upload"></i> Upload new photo</button>
      <button id="prof-apply" class="ab">Apply URL</button>
      <button id="prof-reset" class="ab">Reset</button>
     </div>
    </div>

    <div id="t-data" class="tabp hidden p-5 space-y-5">
     <div class="space-y-2">
      <p class="text-sm font-bold">Backup</p>
      <p class="text-xs text-zinc-400">Edits live in this browser. Export a backup file, and import it on another device.</p>
      <div class="flex flex-wrap gap-2">
       <button id="exp-btn" class="ab"><i class="fas fa-download"></i> Export backup</button>
       <button id="imp-btn" class="ab"><i class="fas fa-file-import"></i> Import backup</button>
       <button id="reset-all" class="ab"><i class="fas fa-rotate-left"></i> Reset everything</button>
      </div>
     </div>
     <div class="space-y-2">
      <p class="text-sm font-bold">Change password</p>
      <input id="new-pass" type="password" class="inp" placeholder="New password (min 6 characters)">
      <button id="pass-btn" class="ab red">Save password</button>
     </div>
     <button id="logout-btn" class="ab"><i class="fas fa-lock"></i> Lock panel</button>
    </div>
    <p id="toast" class="px-5 pb-4 text-xs text-emerald-400 h-5"></p>
   </div>
  </div>
 </div>
</div>

<input type="file" id="file-add" accept="image/*" multiple class="hidden">
<input type="file" id="file-replace" accept="image/*" class="hidden">
<input type="file" id="file-prof" accept="image/*" class="hidden">
<input type="file" id="file-imp" accept="application/json" class="hidden">

<script>
const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
const KEY='orthohin27_site', PKEY='orthohin27_pass', DEFAULT_PASS='orthohin27';
const DEFAULT_PROFILE='WhatsApp_Image_2026-11-09_at_12.39.00_AM-removebg-preview.png';
const FALLBACK='https://placehold.co/400x400/18181b/ef4444?text=AO';
const sampleBatchmates=[
 {name:'Abrar Al Razee Oytizzoh',roll:'2701',group:'Science',social:'@oytizzoh',photo:'https://placehold.co/300x300/18181b/ef4444?text=Abrar'},
 {name:'Tasnim Ahmed',roll:'2702',group:'Science',social:'@tasnim',photo:'https://placehold.co/300x300/18181b/3f3f46?text=Tasnim'},
 {name:'Raihan Islam',roll:'2703',group:'Commerce',social:'@raihan',photo:'https://placehold.co/300x300/18181b/3f3f46?text=Raihan'}
];

const DEFAULT_GALLERY=[
 {src:'https://scontent.fdac14-1.fna.fbcdn.net/v/t39.30808-6/473551532_...jpg',isVideo:true,videoUrl:'https://www.facebook.com/share/v/1EQKpXcSqm/',title:'Memory 1',caption:'Official batch video on Facebook.'},
 {src:'https://scontent.fdac14-1.fna.fbcdn.net/v/t39.30808-6/473551532_...jpg',isVideo:true,videoUrl:'https://www.facebook.com/share/v/1EQKpXcSqm/',title:'Memory 2',caption:'Official batch video on Facebook.'},
 {src:'https://placehold.co/800x600/18181b/ef4444?text=UPCOMING',title:'UPCOMING',caption:'Upcoming batch memories and events.'}
];

const DEFAULTS=()=>({gallery:DEFAULT_GALLERY,profile:DEFAULT_PROFILE,batchmates:sampleBatchmates});

let state;
try{state=JSON.parse(localStorage.getItem(KEY))||DEFAULTS()}catch(e){state=DEFAULTS()}
if(!state.batchmates) state.batchmates=sampleBatchmates;
if(!state.gallery || state.gallery.length>3){
  state.gallery=DEFAULT_GALLERY;
}

const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

let tt;
function toast(m,bad){const t=$('#toast');if(!t)return;t.textContent=m;t.style.color=bad?'#f87171':'#34d399';clearTimeout(tt);tt=setTimeout(()=>t.textContent='',2500)}
function save(){try{localStorage.setItem(KEY,JSON.stringify(state));toast('Saved successfully');renderSite();return true}catch(e){toast('Storage limit reached.',true);return false}}

/* image helpers */
function compress(file,max=1200){return new Promise((res,rej)=>{
 const fr=new FileReader();fr.onerror=rej;
 fr.onload=()=>{const im=new Image();im.onerror=rej;im.onload=()=>{
  const k=Math.min(1,max/Math.max(im.width,im.height));const c=document.createElement('canvas');
  c.width=Math.round(im.width*k);c.height=Math.round(im.height*k);c.getContext('2d').drawImage(im,0,0,c.width,c.height);
  res(c.toDataURL(file.type==='image/png'&&file.size<300000?'image/png':'image/jpeg',.82))};im.src=fr.result};
 fr.readAsDataURL(file)})}

/* view switching */
function showSection(secId){
 $$('.sec-view').forEach(s=>s.classList.add('hidden'));
 const target=$('#view-'+secId);
 if(target){
  target.classList.remove('hidden');
  window.scrollTo({top:0,behavior:'smooth'});
 }
}

/* public render */
function renderSite(){
 $('#gallery-grid').innerHTML=state.gallery.length?state.gallery.map((g,i)=>`
  <figure class="glass-card rounded-2xl overflow-hidden cursor-pointer relative group" data-lb="${i}">
   ${g.isVideo?`<div class="absolute inset-0 bg-black/40 flex items-center justify-center z-10"><div class="w-14 h-14 rounded-full bg-brand-600 text-white flex items-center justify-center shadow-lg group-hover:scale-110 transition"><i class="fas fa-play text-xl ml-1"></i></div></div>`:''}
   <img src="${g.isVideo?'https://placehold.co/800x600/18181b/ef4444?text=Facebook+Video+Memory':esc(g.src)}" alt="${esc(g.title)}" loading="lazy" class="w-full aspect-[4/3] object-cover" onerror="this.src='https://placehold.co/800x600/18181b/71717a?text=Image+missing'">
   <figcaption class="p-4"><p class="font-bold text-sm">${esc(g.title)}</p><p class="text-xs text-zinc-400 mt-1">${esc(g.caption)}</p></figcaption>
  </figure>`).join(''):'<p class="text-zinc-500 text-sm col-span-full text-center">No photos yet.</p>';
 
 const p=$('#dev-profile-img');p.src=state.profile||DEFAULT_PROFILE;p.onerror=()=>{p.onerror=null;p.src=FALLBACK};
 $('#stat-photos').textContent='500+';
 $('#stat-batchmates-count').textContent=state.batchmates.length;

 // Render batchmates
 $('#batchmates-grid').innerHTML=state.batchmates.length?state.batchmates.map(b=>`
  <div class="glass-card rounded-2xl p-6 text-center space-y-3">
   <div class="w-24 h-24 mx-auto rounded-full overflow-hidden border-2 border-brand-500/50 bg-zinc-900 shadow-md">
    <img src="${esc(b.photo)}" alt="${esc(b.name)}" class="w-full h-full object-cover object-top" onerror="this.src='https://placehold.co/200x200/18181b/ef4444?text=User'">
   </div>
   <div>
    <h4 class="font-bold text-base text-white">${esc(b.name)}</h4>
    <p class="text-xs text-zinc-400 mt-0.5">Roll: ${esc(b.roll||'N/A')} • ${esc(b.group||'Batchmate')}</p>
    ${b.social?`<p class="text-xs text-brand-400 font-mono mt-1">${esc(b.social)}</p>`:''}
   </div>
  </div>`).join(''):'<p class="text-zinc-500 text-sm col-span-full text-center">No registered batchmates yet.</p>';
}

$('#gallery-grid').addEventListener('click',e=>{
 const f=e.target.closest('[data-lb]');if(!f)return;
 const g=state.gallery[f.dataset.lb];
 if(g.isVideo){
  $('#lb-img').classList.add('hidden');
  $('#lb-video-container').classList.remove('hidden');
  $('#lb-cap').textContent=g.title+' — '+g.caption;
  $('#lightbox').classList.remove('hidden');
 }else{
  $('#lb-video-container').classList.add('hidden');
  $('#lb-img').classList.remove('hidden');
  $('#lb-img').src=g.src;$('#lb-cap').textContent=g.title+(g.caption?' — '+g.caption:'');
  $('#lightbox').classList.remove('hidden');
 }
});
$('#lb-close').addEventListener('click',()=>$('#lightbox').classList.add('hidden'));
$('#lightbox').addEventListener('click',e=>{if(e.target===$('#lightbox'))$('#lightbox').classList.add('hidden')});

/* registration photo preview */
let tempRegPhoto=null;
async function previewRegPhoto(e){
 const f=e.target.files[0];if(!f)return;
 try{
  tempRegPhoto=await compress(f,600);
  $('#reg-photo-prev').src=tempRegPhoto;
 }catch(err){alert('Failed to process image')}
}

function handleBatchmateRegister(e){
 e.preventDefault();
 const name=$('#reg-name').value.trim();
 const roll=$('#reg-roll').value.trim();
 const group=$('#reg-group').value.trim();
 const social=$('#reg-social').value.trim();
 if(!tempRegPhoto){alert('Please upload your photo.');return;}

 state.batchmates.unshift({name,roll,group,social,photo:tempRegPhoto});
 save();
 alert('Registration successful! You have been added to the Batchmates Directory.');
 e.target.reset();
 tempRegPhoto=null;
 $('#reg-photo-prev').src='https://placehold.co/150x150/18181b/ef4444?text=Photo';
 showSection('batchmates');
}

/* admin list rendering & management */
function renderAdminList(){
 $('#count').textContent=state.gallery.length;
 $('#admin-list').innerHTML=state.gallery.map((g,i)=>`
  <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-3 flex flex-col sm:flex-row gap-3 items-center" data-i="${i}">
   <img src="${g.isVideo?'https://placehold.co/200x150/18181b/ef4444?text=Video':esc(g.src)}" class="w-20 h-16 rounded-lg object-cover flex-shrink-0" onerror="this.src='https://placehold.co/200x150/18181b/ef4444?text=Error'">
   <div class="flex-grow w-full space-y-2">
    <input class="inp adm-title" value="${esc(g.title)}" placeholder="Title">
    <input class="inp adm-cap" value="${esc(g.caption)}" placeholder="Caption">
   </div>
   <div class="flex sm:flex-col gap-1 w-full sm:w-auto justify-end">
    ${!g.isVideo?`<button class="ab replace-btn" title="Replace image"><i class="fas fa-image"></i></button>`:''}
    <button class="ab red del-btn" title="Delete"><i class="fas fa-trash"></i></button>
   </div>
  </div>`).join('');

 $('#admin-batchmates-list').innerHTML=state.batchmates.map((b,i)=>`
  <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-3 flex items-center gap-3" data-bi="${i}">
   <img src="${esc(b.photo)}" class="w-12 h-12 rounded-full object-cover flex-shrink-0" onerror="this.src='https://placehold.co/100x100/18181b/ef4444?text=User'">
   <div class="flex-grow">
    <p class="font-bold text-sm">${esc(b.name)}</p>
    <p class="text-xs text-zinc-400">Roll: ${esc(b.roll)} • ${esc(b.group)}</p>
   </div>
   <button class="ab red adm-del-bm" title="Delete"><i class="fas fa-trash"></i></button>
  </div>`).join('');
}

// Admin event bindings
$('#admin-list').addEventListener('input',e=>{
 const row=e.target.closest('[data-i]');if(!row)return;
 const i=+row.dataset.i;
 state.gallery[i].title=row.querySelector('.adm-title').value;
 state.gallery[i].caption=row.querySelector('.adm-cap').value;
 save();
});

$('#admin-batchmates-list').addEventListener('click',e=>{
 const row=e.target.closest('[data-bi]');if(!row)return;
 const i=+row.dataset.bi;
 if(e.target.closest('.adm-del-bm')){
  if(confirm('Remove this batchmate from directory?')){state.batchmates.splice(i,1);save();renderAdminList()}
 }
});

let activeReplaceIdx=null;
$('#admin-list').addEventListener('click',e=>{
 const row=e.target.closest('[data-i]');if(!row)return;
 const i=+row.dataset.i;
 if(e.target.closest('.del-btn')){
  if(confirm('Delete this photo?')){state.gallery.splice(i,1);save();renderAdminList()}
 }
 if(e.target.closest('.replace-btn')){
  activeReplaceIdx=i;$('#file-replace').click();
 }
});

$('#file-replace').addEventListener('change',async e=>{
 const f=e.target.files[0];if(!f||activeReplaceIdx===null)return;
 try{
  const url=await compress(f);
  state.gallery[activeReplaceIdx].src=url;
  save();renderAdminList();toast('Photo replaced');
 }catch(err){toast('Failed to load image',true)}
 e.target.value='';activeReplaceIdx=null;
});

$('#add-btn').addEventListener('click',()=>$('#file-add').click());
$('#file-add').addEventListener('change',async e=>{
 const files=[...e.target.files];if(!files.length)return;
 for(const f of files){
  try{
   const url=await compress(f);
   state.gallery.unshift({src:url,title:f.name.replace(/\.[^/.]+$/, ''),caption:'Batch memory'});
  }catch(err){}
 }
 save();renderAdminList();toast(files.length+' photo(s) added');
 e.target.value='';
});

/* profile admin */
function initProfileTab(){
 const p=$('#prof-prev');p.src=state.profile||DEFAULT_PROFILE;p.onerror=()=>{p.onerror=null;p.src=FALLBACK};
 $('#prof-url').value=state.profile||'';
}
$('#prof-apply').addEventListener('click',()=>{
 state.profile=$('#prof-url').value.trim();save();initProfileTab();toast('Profile photo updated');
});
$('#prof-reset').addEventListener('click',()=>{
 state.profile=DEFAULT_PROFILE;save();initProfileTab();toast('Profile photo reset');
});
$('#prof-upload').addEventListener('click',()=>$('#file-prof').click());
$('#file-prof').addEventListener('change',async e=>{
 const f=e.target.files[0];if(!f)return;
 try{
  state.profile=await compress(f,600);
  save();initProfileTab();toast('Profile photo uploaded');
 }catch(err){toast('Failed to load image',true)}
 e.target.value='';
});

/* backup & data */
$('#exp-btn').addEventListener('click',()=>{
 const blob=new Blob([JSON.stringify(state,null,2)],{type:'application/json'});
 const url=URL.createObjectURL(blob);
 const a=document.createElement('a');a.href=url;a.download=`orthohin27_backup_${new Date().toISOString().slice(0,10)}.json`;
 a.click();URL.revokeObjectURL(url);toast('Backup exported');
});
$('#imp-btn').addEventListener('click',()=>$('#file-imp').click());
$('#file-imp').addEventListener('change',e=>{
 const f=e.target.files[0];if(!f)return;
 const r=new FileReader();
 r.onload=ev=>{
  try{
   const d=JSON.parse(ev.target.result);
   if(d&&Array.isArray(d.gallery)){
    state=d;if(!state.batchmates)state.batchmates=sampleBatchmates;save();renderAdminList();initProfileTab();toast('Backup imported successfully');
   }else{toast('Invalid backup file format',true)}
  }catch(err){toast('Failed to parse backup JSON',true)}
 };
 r.readAsText(f);e.target.value='';
});
$('#reset-all').addEventListener('click',()=>{
 if(confirm('Reset all gallery photos and settings to default?')){
  state=DEFAULTS();localStorage.removeItem(PKEY);save();renderAdminList();initProfileTab();toast('Reset to default');
 }
});
$('#pass-btn').addEventListener('click',()=>{
 const p=$('#new-pass').value;
 if(p.length<6){toast('Password must be at least 6 characters',true);return}
 localStorage.setItem(PKEY,p);$('#new-pass').value='';toast('Password updated successfully');
});

/* modal & auth flow */
let taps=0,tapTimer=null;
$('#dev-img-container').addEventListener('click',()=>{
 taps++;clearTimeout(tapTimer);
 if(taps>=5){taps=0;openAdminModal()}
 else{tapTimer=setTimeout(()=>taps=0,600)}
});

function openAdminModal(){
 $('#admin-modal').classList.remove('hidden');
 $('#admin-pass').value='';$('#login-err').classList.add('hidden');
 $('#admin-login').classList.remove('hidden');
 $('#admin-panel').classList.add('hidden');
}
$('#admin-close').addEventListener('click',()=>$('#admin-modal').classList.add('hidden'));
$('#admin-modal').addEventListener('click',e=>{if(e.target===$('#admin-modal'))$('#admin-modal').classList.add('hidden')});

$('#login-btn').addEventListener('click',()=>{
 const p=$('#admin-pass').value;
 const pass=localStorage.getItem(PKEY)||DEFAULT_PASS;
 if(p===pass){
  $('#admin-login').classList.add('hidden');
  $('#admin-panel').classList.remove('hidden');
  renderAdminList();initProfileTab();
 }else{
  $('#login-err').classList.remove('hidden');
 }
});
$('#admin-pass').addEventListener('keypress',e=>{if(e.key==='Enter')$('#login-btn').click()});
$('#logout-btn').addEventListener('click',openAdminModal);

// Tabs in admin
$$('.tab').forEach(b=>{
 b.addEventListener('click',()=>{
  $$('.tab').forEach(x=>{x.classList.remove('red');x.classList.add('zinc-800')});
  b.classList.add('red');b.classList.remove('zinc-800');
  $$('.tabp').forEach(p=>p.classList.add('hidden'));
  $(`#${b.dataset.tab}`).classList.remove('hidden');
 });
});

// Mobile menu
function toggleMob(){$('#mobile-drawer').classList.toggle('hidden')}
$('#mobile-menu-btn').addEventListener('click',toggleMob);

// Init
renderSite();
</script>
</body>
</html>