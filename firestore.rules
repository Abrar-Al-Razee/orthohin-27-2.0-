rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared primitive helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        'email' in request.auth.token &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() in ['abraralraze@gmail.com', 'hisamulhisam208@gmail.com'] &&
        request.auth.token.email_verified == true;
    }

    // Startup connection check document
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // Entity validation blueprints
    function isValidBatchmate(data) {
      return data.keys().hasAll(['name', 'roll', 'group', 'createdAt']) &&
        data.keys().hasOnly([
          'name', 'nickname', 'roll', 'group', 'social', 'quote', 'photo',
          'hobbies', 'bloodGroup', 'dreamGoal', 'favoriteMemory', 'hangoutSpot',
          'birthday', 'superpower', 'registeredAt', 'createdAt'
        ]) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        (!('nickname' in data) || (data.nickname is string && data.nickname.size() <= 60)) &&
        data.roll is string && data.roll.size() >= 1 && data.roll.size() <= 32 &&
        data.group is string && data.group.size() >= 1 && data.group.size() <= 60 &&
        (!('social' in data) || (data.social is string && data.social.size() <= 100)) &&
        (!('quote' in data) || (data.quote is string && data.quote.size() <= 400)) &&
        (!('photo' in data) || (data.photo is string && data.photo.size() <= 350000)) &&
        (!('hobbies' in data) || (data.hobbies is string && data.hobbies.size() <= 240)) &&
        (!('bloodGroup' in data) || (data.bloodGroup is string && data.bloodGroup.size() <= 20)) &&
        (!('dreamGoal' in data) || (data.dreamGoal is string && data.dreamGoal.size() <= 200)) &&
        (!('favoriteMemory' in data) || (data.favoriteMemory is string && data.favoriteMemory.size() <= 400)) &&
        (!('hangoutSpot' in data) || (data.hangoutSpot is string && data.hangoutSpot.size() <= 140)) &&
        (!('birthday' in data) || (data.birthday is string && data.birthday.size() <= 40)) &&
        (!('superpower' in data) || (data.superpower is string && data.superpower.size() <= 140)) &&
        (!('registeredAt' in data) || (data.registeredAt is string && data.registeredAt.size() <= 32)) &&
        data.createdAt is timestamp;
    }

    function isValidBatchmateContact(data) {
      return data.keys().hasAll(['batchmateId', 'name', 'roll', 'group', 'createdAt']) &&
        data.keys().hasOnly(['batchmateId', 'name', 'roll', 'group', 'email', 'phone', 'createdAt']) &&
        data.batchmateId is string && data.batchmateId.size() >= 1 && data.batchmateId.size() <= 128 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.roll is string && data.roll.size() >= 1 && data.roll.size() <= 32 &&
        data.group is string && data.group.size() >= 1 && data.group.size() <= 60 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
        data.createdAt is timestamp;
    }

    function isValidNotice(data) {
      return data.keys().hasAll(['title', 'message', 'category', 'pinned', 'active', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['title', 'message', 'category', 'pinned', 'active', 'createdAt', 'updatedAt']) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 1000 &&
        data.category in ['General', 'Urgent', 'Event'] &&
        data.pinned is bool &&
        data.active is bool &&
        data.createdAt is string && data.createdAt.size() >= 1 && data.createdAt.size() <= 32 &&
        data.updatedAt is timestamp;
    }

    function isValidGalleryItem(data) {
      return data.keys().hasAll(['src', 'title', 'caption', 'sortOrder', 'updatedAt']) &&
        data.keys().hasOnly(['src', 'title', 'caption', 'date', 'isVideo', 'videoUrl', 'sortOrder', 'updatedAt']) &&
        data.src is string && data.src.size() <= 350000 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.caption is string && data.caption.size() <= 400 &&
        (!('date' in data) || (data.date is string && data.date.size() <= 40)) &&
        (!('isVideo' in data) || data.isVideo is bool) &&
        (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 500)) &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000 &&
        data.updatedAt is timestamp;
    }

    function isValidAdminTeamMember(data) {
      return data.keys().hasAll(['name', 'role', 'bio', 'sortOrder', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'role', 'bio', 'photo', 'social', 'sortOrder', 'updatedAt']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.role is string && data.role.size() >= 1 && data.role.size() <= 120 &&
        data.bio is string && data.bio.size() <= 500 &&
        (!('photo' in data) || (data.photo is string && data.photo.size() <= 350000)) &&
        (!('social' in data) || (data.social is string && data.social.size() <= 200)) &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000 &&
        data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['orderCode', 'customerName', 'roll', 'size', 'quantity', 'contact', 'status', 'createdAt']) &&
        data.keys().hasOnly(['orderCode', 'customerName', 'roll', 'size', 'quantity', 'contact', 'email', 'notes', 'status', 'paymentStatus', 'createdAt']) &&
        data.orderCode is string && data.orderCode.size() >= 3 && data.orderCode.size() <= 32 &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100 &&
        data.roll is string && data.roll.size() >= 1 && data.roll.size() <= 32 &&
        data.size in ['S', 'M', 'L', 'XL', 'XXL', 'XXXL'] &&
        data.quantity is int && data.quantity >= 1 && data.quantity <= 5 &&
        data.contact is string && data.contact.size() >= 1 && data.contact.size() <= 100 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 300)) &&
        data.status in ['Pending', 'Confirmed', 'Delivered'] &&
        (!('paymentStatus' in data) || data.paymentStatus in ['Due', 'Paid']) &&
        data.createdAt is timestamp;
    }

    function isValidPublicHoodieOrder(data) {
      return data.keys().hasAll(['orderCode', 'customerName', 'roll', 'size', 'quantity', 'status', 'paymentStatus', 'createdAt']) &&
        data.keys().hasOnly(['orderCode', 'customerName', 'roll', 'size', 'quantity', 'notes', 'status', 'paymentStatus', 'createdAt']) &&
        data.orderCode is string && data.orderCode.size() >= 3 && data.orderCode.size() <= 32 &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100 &&
        data.roll is string && data.roll.size() >= 1 && data.roll.size() <= 32 &&
        data.size in ['S', 'M', 'L', 'XL', 'XXL', 'XXXL'] &&
        data.quantity is int && data.quantity >= 1 && data.quantity <= 5 &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 300)) &&
        data.status in ['Pending', 'Confirmed', 'Delivered'] &&
        data.paymentStatus in ['Due', 'Paid'] &&
        data.createdAt is timestamp;
    }

    function isValidHoodieMap(h) {
      return h is map &&
        h.keys().hasAll(['title', 'subtitle', 'frontImage', 'backImage', 'specs', 'directOrderOpen']) &&
        h.keys().hasOnly(['kicker', 'title', 'subtitle', 'frontImage', 'backImage', 'frontLabel', 'backLabel', 'specs', 'directOrderOpen']) &&
        h.title is string && h.title.size() >= 1 && h.title.size() <= 120 &&
        h.subtitle is string && h.subtitle.size() <= 500 &&
        h.frontImage is string && h.frontImage.size() <= 350000 &&
        h.backImage is string && h.backImage.size() <= 350000 &&
        h.specs is list && h.specs.size() > 0 && h.specs.size() <= 12 &&
        h.specs[0] is string && h.specs[0].size() <= 140 &&
        h.directOrderOpen is bool;
    }

    function isValidSectionsMap(sec) {
      return sec is map &&
        sec.keys().hasAll(['notices', 'about', 'gallery', 'directory', 'timeline', 'hoodieNav']) &&
        sec.keys().hasOnly(['notices', 'about', 'gallery', 'directory', 'timeline', 'hoodieNav']) &&
        sec.notices is bool &&
        sec.about is bool &&
        sec.gallery is bool &&
        sec.directory is bool &&
        sec.timeline is bool &&
        sec.hoodieNav is bool;
    }

    function isValidSiteMap(s) {
      return s is map &&
        s.keys().hasAll(['heroKicker', 'heroTitle', 'heroHighlight', 'heroDescription', 'announcement', 'instagramUrl', 'devNote']) &&
        s.keys().hasOnly([
          'brandName', 'brandAccent', 'heroKicker', 'heroTitle', 'heroHighlight', 'heroDescription',
          'heroImage', 'announcement', 'instagramUrl', 'instagramHandle', 'instagramBio', 'devNote',
          'aboutKicker', 'aboutTitle', 'aboutDescription', 'visionTitle', 'visionText',
          'unityTitle', 'unityText', 'leadSectionKicker', 'leadSectionTitle', 'leadSectionSubtitle',
          'leadRole', 'leadName', 'footerText', 'registrationOpen', 'maintenanceMode',
          'maintenanceMessage', 'sections', 'kpis', 'timeline'
        ]) &&
        s.heroKicker is string && s.heroKicker.size() <= 120 &&
        s.heroTitle is string && s.heroTitle.size() <= 120 &&
        s.heroHighlight is string && s.heroHighlight.size() <= 120 &&
        s.heroDescription is string && s.heroDescription.size() <= 600 &&
        s.announcement is string && s.announcement.size() <= 300 &&
        s.instagramUrl is string && s.instagramUrl.size() <= 300 &&
        s.devNote is string && s.devNote.size() <= 600 &&
        (!('heroImage' in s) || (s.heroImage is string && s.heroImage.size() <= 350000)) &&
        (!('sections' in s) || isValidSectionsMap(s.sections)) &&
        (!('kpis' in s) || (s.kpis is list && s.kpis.size() <= 4)) &&
        (!('timeline' in s) || (s.timeline is list && s.timeline.size() <= 20));
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['profile', 'hoodieConfig', 'siteConfig', 'updatedAt']) &&
        data.keys().hasOnly(['profile', 'hoodieConfig', 'siteConfig', 'updatedAt']) &&
        data.profile is string && data.profile.size() <= 350000 &&
        isValidHoodieMap(data.hoodieConfig) &&
        isValidSiteMap(data.siteConfig) &&
        data.updatedAt is timestamp;
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll(['action', 'detail', 'createdAt']) &&
        data.keys().hasOnly(['action', 'detail', 'createdAt']) &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 80 &&
        data.detail is string && data.detail.size() >= 1 && data.detail.size() <= 300 &&
        data.createdAt is timestamp;
    }

    // Public cohort directory; anyone may register instantly without approval, admin manages edits/deletes
    match /batchmates/{batchmateId} {
      allow get: if isValidId(batchmateId);
      allow list: if true;
      allow create: if isValidId(batchmateId) &&
        isValidBatchmate(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(batchmateId) &&
        isAdmin() &&
        isValidBatchmate(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'nickname', 'roll', 'group', 'social', 'quote', 'photo',
          'hobbies', 'bloodGroup', 'dreamGoal', 'favoriteMemory', 'hangoutSpot',
          'birthday', 'superpower', 'registeredAt'
        ]);
      allow delete: if isValidId(batchmateId) && isAdmin();
    }

    // Private admin-only batchmate contact PII (email/phone): public create on registration, admin-only read/update/delete
    match /batchmateContacts/{contactId} {
      allow get: if isValidId(contactId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(contactId) &&
        isValidBatchmateContact(incoming()) &&
        incoming().batchmateId == contactId &&
        incoming().createdAt == request.time;
      allow update: if isValidId(contactId) &&
        isAdmin() &&
        isValidBatchmateContact(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'batchmateId', 'name', 'roll', 'group', 'email', 'phone'
        ]);
      allow delete: if isValidId(contactId) && isAdmin();
    }

    // Official notices: public read, admin-only write
    match /notices/{noticeId} {
      allow get: if isValidId(noticeId);
      allow list: if true;
      allow create: if isValidId(noticeId) &&
        isAdmin() &&
        isValidNotice(incoming()) &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(noticeId) &&
        isAdmin() &&
        isValidNotice(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'message', 'category', 'pinned', 'active', 'updatedAt']);
      allow delete: if isValidId(noticeId) && isAdmin();
    }

    // Memory Vault gallery: public read, admin-only write
    match /gallery/{galleryId} {
      allow get: if isValidId(galleryId);
      allow list: if true;
      allow create: if isValidId(galleryId) &&
        isAdmin() &&
        isValidGalleryItem(incoming()) &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(galleryId) &&
        isAdmin() &&
        isValidGalleryItem(incoming()) &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['src', 'title', 'caption', 'date', 'isVideo', 'videoUrl', 'sortOrder', 'updatedAt']);
      allow delete: if isValidId(galleryId) && isAdmin();
    }

    // Public Admin Panel core team & organizers: public read, admin-only write
    match /adminTeam/{memberId} {
      allow get: if isValidId(memberId);
      allow list: if true;
      allow create: if isValidId(memberId) &&
        isAdmin() &&
        isValidAdminTeamMember(incoming()) &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(memberId) &&
        isAdmin() &&
        isValidAdminTeamMember(incoming()) &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'bio', 'photo', 'social', 'sortOrder', 'updatedAt']);
      allow delete: if isValidId(memberId) && isAdmin();
    }

    // Direct Hoodie orders (contains PII email/contact): public create (Pending & Due only), admin can read/update/delete
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(orderId) &&
        isValidOrder(incoming()) &&
        incoming().createdAt == request.time &&
        ((incoming().status == 'Pending' && (!('paymentStatus' in incoming()) || incoming().paymentStatus == 'Due')) || isAdmin());
      allow update: if isValidId(orderId) &&
        isAdmin() &&
        isValidOrder(incoming()) &&
        incoming().orderCode == existing().orderCode &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'customerName', 'roll', 'size', 'quantity', 'contact', 'email', 'notes', 'status', 'paymentStatus'
        ]);
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // Public Hoodie Order profile cards (non-PII): public read & instant create without approval, admin updates payment/status
    match /publicHoodieOrders/{orderId} {
      allow get: if isValidId(orderId);
      allow list: if true;
      allow create: if isValidId(orderId) &&
        isValidPublicHoodieOrder(incoming()) &&
        incoming().createdAt == request.time &&
        ((incoming().status == 'Pending' && incoming().paymentStatus == 'Due') || isAdmin());
      allow update: if isValidId(orderId) &&
        isAdmin() &&
        isValidPublicHoodieOrder(incoming()) &&
        incoming().orderCode == existing().orderCode &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'customerName', 'roll', 'size', 'quantity', 'notes', 'status', 'paymentStatus'
        ]);
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // Portal settings (hoodieConfig, siteConfig, profile): public read, admin-only write
    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if false;
      allow create, update: if isValidId(settingId) &&
        isAdmin() &&
        isValidSettings(incoming()) &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(settingId) && isAdmin();
    }

    // Admin audit log: admin-only read/create, immutable
    match /activityLogs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(logId) &&
        isAdmin() &&
        isValidActivityLog(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(logId) && isAdmin();
    }
  }
}
