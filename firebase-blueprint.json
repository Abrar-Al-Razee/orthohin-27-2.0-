{
  "entities": {
    "Batchmate": {
      "title": "Batchmate",
      "description": "A registered student member of Orthohin '27.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Full name of the batchmate."
        },
        "nickname": {
          "type": "string",
          "maxLength": 60,
          "description": "Optional nickname or dak nam."
        },
        "roll": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Roll or batch ID number."
        },
        "group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Academic group or section."
        },
        "social": {
          "type": "string",
          "maxLength": 100,
          "description": "Optional Instagram or social handle."
        },
        "quote": {
          "type": "string",
          "maxLength": 400,
          "description": "Optional batch bio or memory note."
        },
        "photo": {
          "type": "string",
          "maxLength": 350000,
          "description": "Optional compressed portrait data URL or asset path."
        },
        "hobbies": {
          "type": "string",
          "maxLength": 240,
          "description": "Hobbies and personal interests displayed on card back."
        },
        "bloodGroup": {
          "type": "string",
          "maxLength": 20,
          "description": "Optional blood group."
        },
        "dreamGoal": {
          "type": "string",
          "maxLength": 200,
          "description": "Future ambition or career goal."
        },
        "favoriteMemory": {
          "type": "string",
          "maxLength": 400,
          "description": "Favorite campus or batch memory."
        },
        "hangoutSpot": {
          "type": "string",
          "maxLength": 140,
          "description": "Favorite school hangout spot."
        },
        "birthday": {
          "type": "string",
          "maxLength": 40,
          "description": "Birthday month and day."
        },
        "superpower": {
          "type": "string",
          "maxLength": 140,
          "description": "Batch nickname trait, talent, or known-for superpower."
        },
        "registeredAt": {
          "type": "string",
          "maxLength": 32,
          "description": "Display registration date string."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["name", "roll", "group", "createdAt"]
    },
    "BatchmateContact": {
      "title": "BatchmateContact",
      "description": "Private admin-only contact details (email and phone) for a registered batchmate.",
      "type": "object",
      "properties": {
        "batchmateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Matching batchmate document ID."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Batchmate full name."
        },
        "roll": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Roll number."
        },
        "group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Academic group."
        },
        "email": {
          "type": "string",
          "maxLength": 160,
          "description": "Email address for admin communication."
        },
        "phone": {
          "type": "string",
          "maxLength": 40,
          "description": "Optional phone or WhatsApp number."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["batchmateId", "name", "roll", "group", "createdAt"]
    },
    "BatchNotice": {
      "title": "BatchNotice",
      "description": "An official announcement or notice published by the batch admin.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "Notice headline."
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "Notice body text."
        },
        "category": {
          "type": "string",
          "enum": ["General", "Urgent", "Event"],
          "description": "Notice priority category."
        },
        "pinned": {
          "type": "boolean",
          "description": "Whether the notice is pinned to top."
        },
        "active": {
          "type": "boolean",
          "description": "Whether the notice is visible on the public portal."
        },
        "createdAt": {
          "type": "string",
          "maxLength": 32,
          "description": "Display creation date."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["title", "message", "category", "pinned", "active", "createdAt", "updatedAt"]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "A photo or video memory in the Memory Vault.",
      "type": "object",
      "properties": {
        "src": {
          "type": "string",
          "maxLength": 300000,
          "description": "Compressed image data URL or empty string."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "Memory title."
        },
        "caption": {
          "type": "string",
          "maxLength": 400,
          "description": "Memory description."
        },
        "date": {
          "type": "string",
          "maxLength": 40,
          "description": "Display month/year."
        },
        "isVideo": {
          "type": "boolean",
          "description": "Whether this item links to a video."
        },
        "videoUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional external video URL."
        },
        "sortOrder": {
          "type": "number",
          "description": "Ordering index."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp."
        }
      },
      "required": ["src", "title", "caption", "sortOrder", "updatedAt"]
    },
    "HoodieOrder": {
      "title": "HoodieOrder",
      "description": "A direct RCS Hoodie '26-'27 order submitted by a batchmate.",
      "type": "object",
      "properties": {
        "orderCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "description": "Short order reference code."
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Ordering student name."
        },
        "roll": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Student roll or batch ID."
        },
        "size": {
          "type": "string",
          "enum": ["S", "M", "L", "XL", "XXL", "XXXL"],
          "description": "Hoodie size."
        },
        "quantity": {
          "type": "integer",
          "description": "Number of hoodies ordered (1-5)."
        },
        "contact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Phone number or social handle."
        },
        "email": {
          "type": "string",
          "maxLength": 160,
          "description": "Optional customer email for invoice and payment notices (admin-only)."
        },
        "notes": {
          "type": "string",
          "maxLength": 300,
          "description": "Optional delivery or section note."
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "Confirmed", "Delivered"],
          "description": "Fulfillment status."
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["Due", "Paid"],
          "description": "Payment verification status (Due 700 BDT/pc vs Paid)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["orderCode", "customerName", "roll", "size", "quantity", "contact", "status", "createdAt"]
    },
    "PublicHoodieOrder": {
      "title": "PublicHoodieOrder",
      "description": "Public non-PII live order profile card shown below the Hoodie order form (excludes email and phone contact).",
      "type": "object",
      "properties": {
        "orderCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "description": "Exact order reference code matching /orders/{orderId}."
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Ordering student name."
        },
        "roll": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Student roll or batch ID."
        },
        "size": {
          "type": "string",
          "enum": ["S", "M", "L", "XL", "XXL", "XXXL"],
          "description": "Hoodie size."
        },
        "quantity": {
          "type": "integer",
          "description": "Number of hoodies ordered (1-5)."
        },
        "notes": {
          "type": "string",
          "maxLength": 300,
          "description": "Optional delivery or section note."
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "Confirmed", "Delivered"],
          "description": "Fulfillment status."
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["Due", "Paid"],
          "description": "Payment verification status (Due vs Paid)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["orderCode", "customerName", "roll", "size", "quantity", "status", "paymentStatus", "createdAt"]
    },
    "PortalSettings": {
      "title": "PortalSettings",
      "description": "Global portal configuration document (hoodieConfig, siteConfig, profile).",
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "maxLength": 350000,
          "description": "Lead developer profile image."
        },
        "hoodieConfig": {
          "type": "object",
          "description": "RCS Hoodie kicker, title, subtitle, front/back images and labels, specs, and directOrderOpen flag."
        },
        "siteConfig": {
          "type": "object",
          "description": "Full portal configuration including brand, hero, KPIs, About/Vision/Unity, Instagram hub, leadership lead, timeline milestones, section visibility, maintenance lock, and footer."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp."
        }
      },
      "required": ["profile", "hoodieConfig", "siteConfig", "updatedAt"]
    },
    "ActivityLogEntry": {
      "title": "ActivityLogEntry",
      "description": "Audit log item for admin actions.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Action label."
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Action summary."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp."
        }
      },
      "required": ["action", "detail", "createdAt"]
    },
    "AdminTeamMember": {
      "title": "AdminTeamMember",
      "description": "An organizer or core admin running Orthohin '27 displayed on the public Admin Panel page.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Full name of the admin or organizer."
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Role or designation in Orthohin '27."
        },
        "bio": {
          "type": "string",
          "maxLength": 500,
          "description": "Bio or responsibility description."
        },
        "photo": {
          "type": "string",
          "maxLength": 350000,
          "description": "Optional compressed portrait image or asset path."
        },
        "social": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional social profile URL or handle."
        },
        "sortOrder": {
          "type": "number",
          "description": "Display ordering index."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp."
        }
      },
      "required": ["name", "role", "bio", "sortOrder", "updatedAt"]
    }
  },
  "firestore": {
    "/batchmates/{batchmateId}": {
      "schema": { "$ref": "#/entities/Batchmate" },
      "description": "Public directory of registered Orthohin '27 batchmates."
    },
    "/batchmateContacts/{contactId}": {
      "schema": { "$ref": "#/entities/BatchmateContact" },
      "description": "Private admin-only email and phone directory for registered batchmates."
    },
    "/notices/{noticeId}": {
      "schema": { "$ref": "#/entities/BatchNotice" },
      "description": "Official batch notices managed by admin."
    },
    "/gallery/{galleryId}": {
      "schema": { "$ref": "#/entities/GalleryItem" },
      "description": "Memory Vault photos and video links."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/HoodieOrder" },
      "description": "Direct RCS Hoodie orders including PII email/contact (admin-readable only; public create)."
    },
    "/publicHoodieOrders/{orderId}": {
      "schema": { "$ref": "#/entities/PublicHoodieOrder" },
      "description": "Public non-PII hoodie order cards shown live below the Hoodie form."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/PortalSettings" },
      "description": "Portal configuration document (settings/main)."
    },
    "/activityLogs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLogEntry" },
      "description": "Admin-only audit log entries."
    },
    "/adminTeam/{memberId}": {
      "schema": { "$ref": "#/entities/AdminTeamMember" },
      "description": "Public core leadership and organizer cards displayed on the Admin Panel page."
    }
  }
}
